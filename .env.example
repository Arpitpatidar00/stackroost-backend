# Copy to .env for local development. Production values live in your secret store.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Reverse proxies in front of the API (load balancer = 1). Drives req.ip (rate limits, webhook IPs).
TRUST_PROXY_HOPS=0

DATABASE_URL=postgresql://stackroost:stackroost@localhost:5432/stackroost

# Public URLs. Google redirects to ${API_URL}/v1/auth/google/callback (register it in Google Cloud).
API_URL=http://localhost:4000
WEBSITE_URL=http://localhost:3000
CORS_EXTRA_ORIGINS=

# ≥ 32 random chars: `openssl rand -base64 48`. Signs the OAuth state cookie and checkout links.
SESSION_SECRET=
SESSION_TTL_DAYS=30
SESSION_IDLE_DAYS=7
ADMIN_RECENT_AUTH_HOURS=12
# Comma-separated emails that become admins on Google sign-in (bootstrap only).
ADMIN_EMAILS=

# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Paddle Billing — sandbox while developing. Separate destination + secret per environment.
PADDLE_ENV=sandbox
PADDLE_API_KEY=pdl_sdbx_apikey_replace_me
PADDLE_WEBHOOK_SECRET=pdl_ntfset_replace_me
PADDLE_CLIENT_TOKEN=test_replace_me
# Only accept webhooks from api.paddle.com/ips. Defaults: on in production (cannot be disabled), off locally.
# PADDLE_WEBHOOK_IP_ALLOWLIST=false

# npm run keys:generate → paste both lines here.
LICENSE_SIGNING_PRIVATE_KEY=
LICENSE_SIGNING_PUBLIC_KEY=
LICENSE_SIGNING_KEY_ID=k1
LICENSE_TOKEN_TTL_DAYS=14
LICENSE_MAX_DEVICES=3
PAST_DUE_GRACE_DAYS=7
# Scheduled downgrades are pushed to Paddle this long before renewal.
DOWNGRADE_APPLY_LEAD_MINUTES=60

MAIL_FROM="Stackroost <hello@stackroost.dev>"
