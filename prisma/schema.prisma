// Stackroost billing & licensing.
// Paddle is the source of truth for billing; customers/subscriptions here are a
// webhook-synced mirror keyed on Paddle ids (idempotent UPSERTs). Secrets
// (license keys and session tokens) are stored only as SHA-256 hashes.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  admin
}

/// A person. Registers with Google (googleSub is the stable identity; email can change).
model Account {
  id          String    @id @default(cuid())
  email       String    @unique /// lower-cased, Google-verified
  googleSub   String?   @unique
  name        String?
  role        Role      @default(user)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customers Customer[]
  license   License?
  sessions  Session[]

  @@index([role])
  @@map("accounts")
}

/// A sellable plan. Admin-managed; `modules`/`features` are Stackroost app ids.
model Plan {
  id              String   @id @default(cuid())
  key             String   @unique /// stable slug, e.g. "pro" — sent to the app
  name            String
  description     String   @default("")
  /// Ordering for upgrade (higher) vs downgrade (lower).
  rank            Int      @unique
  modules         String[]
  features        String[]
  isActive        Boolean  @default(true)
  paddleProductId String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  prices PlanPrice[]

  @@map("plans")
}

enum BillingInterval {
  month
  year
}

/// A Paddle price for a plan. Subscriptions reference prices; the price decides the plan.
model PlanPrice {
  id            String          @id @default(cuid())
  planId        String
  paddlePriceId String          @unique
  interval      BillingInterval
  amountMinor   Int /// e.g. cents
  currency      String
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  plan Plan @relation(fields: [planId], references: [id])

  @@index([planId])
  @@map("plan_prices")
}

enum CouponType {
  percentage
  flat
}

/// Admin-created promo code, mirrored from a Paddle discount (Paddle applies it at checkout).
model Coupon {
  id                    String     @id @default(cuid())
  code                  String     @unique /// upper-cased
  paddleDiscountId      String     @unique
  type                  CouponType
  /// percentage: "10" = 10 %; flat: minor units as string ("500" = 5.00)
  amount                String
  currency              String?
  /// Applies to every renewal (true) or first payment only.
  recurring             Boolean    @default(false)
  maxRecurringIntervals Int?
  usageLimit            Int?
  expiresAt             DateTime?
  /// Empty = every plan.
  planIds               String[]
  isActive              Boolean    @default(true)
  createdById           String
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@map("coupons")
}

/// Mirror of a Paddle customer (ctm_…).
model Customer {
  id        String   @id /// Paddle customer id
  email     String? /// null until customer.created arrives (events are unordered)
  accountId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account       Account?       @relation(fields: [accountId], references: [id])
  subscriptions Subscription[]

  @@index([email])
  @@index([accountId])
  @@map("customers")
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  paused
  canceled
}

/// Mirror of a Paddle subscription (sub_…).
model Subscription {
  id                    String             @id /// Paddle subscription id
  customerId            String
  status                SubscriptionStatus
  priceId               String
  productId             String
  currentPeriodEndsAt   DateTime?
  scheduledChangeAction String? /// cancel | pause | resume
  scheduledChangeAt     DateTime?
  /// occurred_at of the event that last wrote this row: older events never overwrite newer state.
  lastEventAt           DateTime
  /// Downgrade requested; applied in Paddle shortly before the period ends (worker).
  pendingPriceId        String?
  pendingRequestedAt    DateTime?
  /// After a downgrade is applied, the previous plan stays entitled until graceUntil.
  graceFromPriceId      String?
  graceUntil            DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([pendingPriceId])
  @@map("subscriptions")
}

enum LicenseStatus {
  active
  revoked
}

/// One license per account. The plan it grants is derived from the account's
/// subscriptions at activation/refresh time, never stored here.
model License {
  id         String        @id @default(cuid())
  accountId  String        @unique
  keyHash    String        @unique
  keyPreview String /// e.g. "SR-7K2Q…X9PD", safe to display
  maxDevices Int           @default(3)
  status     LicenseStatus @default(active)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  account     Account      @relation(fields: [accountId], references: [id])
  activations Activation[]

  @@map("licenses")
}

/// A Mac the license is activated on.
model Activation {
  id         String   @id @default(cuid())
  licenseId  String
  deviceId   String /// opaque, app-derived hash of the machine id
  deviceName String
  appVersion String
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, deviceId])
  @@map("activations")
}

/// Ledger of processed Paddle events (dedup on event_id for non-idempotent side effects).
model WebhookEvent {
  id          String   @id /// Paddle event_id
  eventType   String
  occurredAt  DateTime
  processedAt DateTime @default(now())

  @@map("webhook_events")
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  accountId  String
  /// Absolute expiry; idle expiry is lastUsedAt + SESSION_IDLE_DAYS.
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
  @@map("sessions")
}

enum OutboxStatus {
  pending
  done
  failed
}

/// Transactional outbox: side effects (emails) are written in the same
/// transaction as the state change and delivered by the worker after commit.
model OutboxJob {
  id        String       @id @default(cuid())
  type      String
  payload   Json
  status    OutboxStatus @default(pending)
  attempts  Int          @default(0)
  runAfter  DateTime     @default(now())
  lastError String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status, runAfter])
  @@map("outbox_jobs")
}

/// Append-only record of every admin action (who, what, on which entity, from where).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String /// e.g. "coupon.create", "subscription.cancel"
  targetType String
  targetId   String
  metadata   Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Shared fixed-window rate-limit counters (correct across multiple API instances).
model RateLimitBucket {
  key     String   @id
  hits    Int
  resetAt DateTime

  @@index([resetAt])
  @@map("rate_limit_buckets")
}
